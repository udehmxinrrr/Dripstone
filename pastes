<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hero — New Drop</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>

  :root{
    --bg: #0E1A17;
    --bg-soft: #142621;
    --tangerine: #FF6B35;
    --lime: #C6F135;
    --hotpink: #FF2E63;
    --cream: #FFF8ED;
    --cream-dim: #C9C2B3;
    --line: rgba(255,248,237,0.14);
  }

  *{ margin:0; padding:0; box-sizing:border-box; }

  body{
    background: var(--bg);
    color: var(--cream);
    font-family: 'Space Grotesk', sans-serif;
    overflow-x:hidden;
  }

  .hero{
    position:relative;
    min-height: 500px;
    display:flex;
    flex-direction:column;
    background:
      radial-gradient(ellipse 900px 500px at 82% 18%, rgba(255,107,53,0.20), transparent 60%),
      radial-gradient(ellipse 700px 500px at 10% 85%, rgba(198,241,53,0.10), transparent 60%),
      var(--bg);
  }

  /* ---------- NAV ---------- */
  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 28px 6vw;
    z-index:5;
    position:relative;
  }

  .logo{
    font-family:'Bebas Neue', sans-serif;
    font-size: 26px;
    letter-spacing: 2px;
    color: var(--cream);
  }
  .logo span{ color: var(--lime); }

  .nav-links{
    display:flex;
    gap: 32px;
    list-style:none;
    font-size: 14px;
    font-weight:500;
    color: var(--cream-dim);
  }
  .nav-links li{ cursor:pointer; transition: color .2s ease; }
  .nav-links li:hover{ color: var(--cream); }

  .nav-icons{
    display:flex;
    align-items:center;
    gap: 18px;
  }
  .cart-btn{
    display:flex;
    align-items:center;
    gap:8px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--cream);
    font-family:'Space Grotesk', sans-serif;
    font-size:13px;
    font-weight:600;
    padding: 10px 16px;
    border-radius: 999px;
    cursor:pointer;
    transition: border-color .2s ease, transform .2s ease;
  }
  .cart-btn:hover{ border-color: var(--lime); transform: translateY(-1px); }
  .cart-count{
    background: var(--lime);
    color: var(--bg);
    font-size: 11px;
    font-weight:700;
    width: 18px; height: 18px;
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
  }

  /* ---------- MARQUEE SIGNATURE BAND ---------- */
  .marquee-band{
    position:absolute;
    left: -8%;
    width: 116%;
    top: 40%;
    transform: rotate(-4deg);
    background: var(--tangerine);
    padding: 14px 0;
    z-index:2;
    box-shadow: 0 20px 60px rgba(255,107,53,0.25);
  }
  .marquee-track{
    display:flex;
    width: max-content;
    animation: scroll-left 26s linear infinite;
  }
  .marquee-track span{
    font-family:'Bebas Neue', sans-serif;
    font-size: 22px;
    letter-spacing: 3px;
    color: var(--bg);
    padding: 0 28px;
    white-space:nowrap;
    display:flex;
    align-items:center;
    gap: 28px;
  }
  .marquee-track span::after{
    content:'●';
    font-size: 8px;
    color: var(--bg);
    opacity:.6;
  }
  @keyframes scroll-left{
    from{ transform: translateX(0); }
    to{ transform: translateX(-50%); }
  }

  /* ---------- MAIN CONTENT ---------- */
  .hero-main{
    position:relative;
    flex:1;
    display:grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items:center;
    padding: 0 6vw 60px;
    gap: 40px;
    z-index:3;
  }

  .copy{
    position:relative;
    z-index:4;
    padding-top: 20px;
  }

  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:10px;
    font-family:'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight:600;
    letter-spacing: 1.5px;
    color: var(--lime);
    background: rgba(198,241,53,0.08);
    border: 1px solid rgba(198,241,53,0.3);
    padding: 7px 14px;
    border-radius: 999px;
    margin-bottom: 28px;
  }
  .eyebrow::before{
    content:'';
    width:7px; height:7px;
    background: var(--lime);
    border-radius:50%;
    box-shadow: 0 0 10px var(--lime);
  }

  .headline{
    font-family:'Bebas Neue', sans-serif;
    font-size: clamp(64px, 9vw, 130px);
    line-height: 0.85;
    letter-spacing: 1px;
    color: var(--cream);
    margin-bottom: 8px;
  }
  .headline .accent{ color: var(--tangerine); }
  .headline .outline{
    -webkit-text-stroke: 2px var(--cream);
    color: transparent;
  }

  .sub{
    max-width: 440px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--cream-dim);
    margin: 28px 0 40px;
    font-weight: 400;
  }

  .cta-row{
    display:flex;
    align-items:center;
    gap: 22px;
    flex-wrap:wrap;
  }

  .btn-primary{
    position:relative;
    background: var(--lime);
    color: var(--bg);
    font-family:'Space Grotesk', sans-serif;
    font-weight:700;
    font-size: 15px;
    padding: 18px 34px;
    border-radius: 10px;
    border:none;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap: 10px;
    transition: transform .2s ease, box-shadow .2s ease;
    box-shadow: 0 8px 0 rgba(0,0,0,0.25);
  }
  .btn-primary:hover{
    transform: translateY(-3px);
    box-shadow: 0 11px 0 rgba(0,0,0,0.25);
  }
  .btn-primary:active{
    transform: translateY(2px);
    box-shadow: 0 3px 0 rgba(0,0,0,0.25);
  }
  .btn-primary svg{ transition: transform .2s ease; }
  .btn-primary:hover svg{ transform: translateX(4px); }

  .btn-secondary{
    background: transparent;
    border: none;
    color: var(--cream);
    font-family:'Space Grotesk', sans-serif;
    font-weight:600;
    font-size: 15px;
    padding: 10px 0;
    cursor:pointer;
    border-bottom: 1px solid var(--line);
    transition: border-color .2s ease, color .2s ease;
  }
  .btn-secondary:hover{ border-color: var(--cream); color: var(--lime); }

  /* ---------- PRODUCT STAGE ---------- */
  .stage{
    position:relative;
    z-index:3;
    display:flex;
    align-items:center;
    justify-content:center;
    height: 560px;
  }

  .product-plate{
    position:relative;
    width: 420px;
    height: 420px;
    border-radius: 32px;
    background: linear-gradient(155deg, var(--bg-soft), #0A1512);
    border: 1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content:center;
    transform: rotate(3deg);
    box-shadow: 0 40px 80px rgba(0,0,0,0.45);
  }

  .product-plate img,
  .product-plate .placeholder-art{
    width: 82%;
    filter: drop-shadow(0 30px 40px rgba(0,0,0,0.5));
    transform: rotate(-3deg);
  }

  /* price tag badge - hand-marked ticket */
  .tag{
    position:absolute;
    background: var(--cream);
    color: var(--bg);
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
    border-radius: 12px;
    padding: 14px 16px;
    box-shadow: 0 14px 30px rgba(0,0,0,0.35);
    display:flex;
    flex-direction:column;
    gap:2px;
    line-height:1.1;
  }
  .tag-price{ font-size:20px; }
  .tag-price .was{
    font-size: 12px;
    color: #8b8578;
    text-decoration: line-through;
    font-weight:500;
    margin-right:6px;
  }
  .tag-label{
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--hotpink);
    text-transform:uppercase;
  }
  .tag--1{ top: -6%; left: -10%; transform: rotate(-8deg); }
  .tag--2{
    bottom: -8%; right: -6%; transform: rotate(6deg);
    background: var(--hotpink);
    color: var(--cream);
  }
  .tag--2 .tag-label{ color: var(--cream); opacity:.75; }
  .tag--2 .tag-price .was{ color: rgba(255,248,237,0.55); }

  .stock-pill{
    position:absolute;
    top: 8%;
    right: -8%;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--cream);
    font-family:'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 8px 12px;
    border-radius: 999px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .stock-pill .dot{
    width:6px; height:6px; border-radius:50%;
    background: var(--tangerine);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse{
    0%,100%{ opacity:1; transform:scale(1); }
    50%{ opacity:.4; transform:scale(0.7); }
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px){
    .hero-main{ grid-template-columns: 1fr; padding-top: 40px; }
    .stage{ height: 380px; order:-1; }
    .product-plate{ width: 300px; height:300px; }
    .nav-links{ display:none; }
    .marquee-band{ top: auto; bottom: 6%; }
  }

  @media (prefers-reduced-motion: reduce){
    .marquee-track{ animation: none; }
    .stock-pill .dot{ animation: none; }
  }

  a:focus-visible, button:focus-visible{
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }
</style>
</head>
<body>

<section class="hero">

  <nav class="nav">
    <div class="logo">FERAL<span>GOODS</span></div>
    <ul class="nav-links">
      <li>New Arrivals</li>
      <li>Men</li>
      <li>Women</li>
      <li>Sale</li>
    </ul>
    <div class="nav-icons">
      <button class="cart-btn">Cart <span class="cart-count">2</span></button>
    </div>
  </nav>

  <div class="marquee-band">
    <div class="marquee-track">
      <span>NEW DROP JUST LANDED</span>
      <span>FREE SHIPPING OVER $75</span>
      <span>LIMITED STOCK — MOVE FAST</span>
      <span>NEW DROP JUST LANDED</span>
      <span>FREE SHIPPING OVER $75</span>
      <span>LIMITED STOCK — MOVE FAST</span>
      <span>NEW DROP JUST LANDED</span>
      <span>FREE SHIPPING OVER $75</span>
      <span>LIMITED STOCK — MOVE FAST</span>
    </div>
  </div>

  <div class="hero-main">
    <div class="copy">
      <div class="eyebrow">DROP 014 — LIVE NOW</div>
      <h1 class="headline">
        NEW<br>
        <span class="accent">DROP.</span><br>
        <span class="outline">JUST LANDED.</span>
      </h1>
      <p class="sub">
        112 pieces. No restocks. Everything you see sells out by Friday —
        the ones who move first get to keep it.
      </p>
      <div class="cta-row">
        <button class="btn-primary">
          Shop the Drop
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="btn-secondary">View Full Collection</button>
      </div>
    </div>

    <div class="stage">
      <div class="product-plate">
        <svg class="placeholder-art" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="100" cy="100" r="86" fill="none" stroke="#C6F135" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.5"/>
          <path d="M60 130 C60 100, 75 70, 110 65 C135 61, 150 75, 150 95 C150 115, 130 125, 130 135 L60 135 Z"
                fill="#FF6B35" opacity="0.9"/>
          <path d="M60 130 L150 130 L150 145 C150 150 145 152 138 152 L68 152 C62 152 60 149 60 145 Z"
                fill="#FFF8ED"/>
        </svg>

        <div class="tag tag--1">
          <span class="tag-label">Best seller</span>
          <span class="tag-price"><span class="was">$129</span>$89</span>
        </div>

        <div class="tag tag--2">
          <span class="tag-label">Only 6 left</span>
          <span class="tag-price">$64</span>
        </div>

        <div class="stock-pill"><span class="dot"></span> 214 sold today</div>
      </div>
    </div>
  </div>

</section>

</body>
</html>